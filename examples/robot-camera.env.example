# Optional official remote camera. Keep the actual token only in ignored .env.
# Install: uv sync --locked --extra vision --extra robot --extra robot-camera
DEPLOYMENT_MODE=reachy_pc
ROBOT_CAMERA_TRANSPORT=webrtc
ROBOT_CAMERA_HF_TOKEN=
ROBOT_CAMERA_PEER_ID=
# The edge URL/token must control the SAME physical robot as the pinned peer.
IAGO_EDGE_URL=http://127.0.0.1:8877
IAGO_EDGE_TOKEN=
# No silent fallback: use ROBOT_CAMERA_TRANSPORT=edge explicitly for LAN JPEG.
# WebRTC capture timing/motion are unqualified; gestures remain suppressed.
